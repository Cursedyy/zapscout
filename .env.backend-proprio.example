# Modelo de configuração. Nunca cadastrar segredos reais neste arquivo ou em VITE_*.
# Os valores reais do servidor ficam no gerenciador de segredos da hospedagem.
# Navegador e servidor devem apontar para o mesmo projeto depois da homologação.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY_FROM_DASHBOARD
VITE_SUPABASE_PROJECT_ID=PROJECT_REF
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY_FROM_DASHBOARD
SUPABASE_PROJECT_ID=PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
# Claude nativo. A assinatura do Claude Code não fornece uso de API ao app.
IA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Escolher um modelo habilitado na sua conta; não há fallback para Lovable.
IA_MODEL=
# Opcionais, usados apenas quando definidos:
IA_MODEL_AGENTE=
IA_MODEL_CLASSIFICACAO=
IA_MODEL_SCORE=
IA_MODEL_CAMPANHAS=
# Jobs são mantidos desligados no destino até corte/homologação.
CRON_SECRET=
PUBLIC_APP_URL=
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=
UAZAPI_WEBHOOK_SECRET=
# Preservar em canal seguro, ou recifrar/reautorizar, antes de copiar tokens:
MIMO_GMAIL_TOKEN_KEY=
MIMO_GMAIL_UNSUBSCRIBE_KEY=
MIMO_NUVEMSHOP_TOKEN_KEY=
MIMO_LANGFUSE_ENABLED=false
