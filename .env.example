# Supabase — banco principal (Postgres + Auth + RLS)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=xxxxx               # chave publica (anon), protegida por RLS
SUPABASE_SERVICE_ROLE_KEY=xxxxx              # bypassa RLS, so em rotas server-side e crons
VITE_SUPABASE_URL=https://xxxxx.supabase.co  # mesma URL, exposta ao bundle client
VITE_SUPABASE_PUBLISHABLE_KEY=xxxxx          # mesma anon key, exposta ao bundle client

# Descoberta de leads
APIFY_TOKEN=xxxxx                            # roda o actor compass~crawler-google-places

# UAZAPI — gateway de WhatsApp
UAZAPI_BASE_URL=https://xxxxx.uazapi.com
UAZAPI_ADMIN_TOKEN=xxxxx                     # cria/gerencia instancias por usuario
UAZAPI_WEBHOOK_SECRET=xxxxx                  # valida ?secret= no webhook de mensagens recebidas

# IA — geracao de resposta ao lead e de campanha
ANTHROPIC_API_KEY=xxxxx                      # resposta ao lead (Claude)
CLAUDE_MODEL=claude-sonnet-5                 # modelo usado na resposta normal
CLAUDE_MODEL_CLASSIFICACAO=claude-haiku-4-5-20251001   # modelo mais barato p/ classificacao em segundo plano
LOVABLE_API_KEY=xxxxx                        # geracao de sequencia de campanha via Lovable AI Gateway

# Billing
KIWIFY_WEBHOOK_SECRET=xxxxx                  # valida o webhook de assinatura da Kiwify

# Crons e hooks publicos
CRON_SECRET=xxxxx                            # header x-cron-secret exigido pelos endpoints /api/public/hooks/*
CAPTCHA_SIGNING_SECRET=xxxxx                 # assina/valida captcha do cadastro publico

# App
PUBLIC_APP_URL=https://app.zapscout.com.br   # URL publica usada em links gerados

# Testes E2E (opcional, so em ambiente de teste)
E2E_BASE_URL=http://localhost:3000
SUPABASE_TEST_USER_EMAIL=teste@example.com
SUPABASE_TEST_USER_PASSWORD=xxxxx
